<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:tei="http://www.tei-c.org/ns/1.0"
  xmlns:xml="http://www.w3.org/XML/1998/namespace"
  exclude-result-prefixes="tei xml">

  <xsl:output method="html" encoding="UTF-8" indent="yes"/>
  <xsl:strip-space elements="tei:TEI tei:teiHeader tei:standOff tei:text tei:body tei:back tei:div tei:list tei:listBibl tei:listPerson tei:listPlace tei:listOrg tei:listEvent tei:listObject tei:object tei:objectIdentifier"/>

  <xsl:key name="by-id" match="*[@xml:id]" use="@xml:id"/>

  <!-- Path prefix for images: '../../' when the HTML file is written next to this stylesheet,
       '' when the website places the Wiki View at its root. -->
  <xsl:param name="base" select="'../../'"/>

  <xsl:template match="/tei:TEI">
    <xsl:variable name="bibl" select="tei:teiHeader/tei:fileDesc/tei:sourceDesc/tei:bibl"/>
    <html lang="en">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title><xsl:value-of select="$bibl/tei:title"/> (TEI-derived Wiki View)</title>
      </head>
      <body>
        <div id="wiki-root" class="wiki">
          <xsl:call-template name="wiki-style"/>
          <p class="wiki-banner">
            <strong>TEI-derived Wiki View</strong>
            <xsl:text> generated by XSLT from reconnecting_dunhuang.xml (source: English Wikipedia, oldid </xsl:text>
            <xsl:value-of select="$bibl/tei:idno[@type='wikipedia-oldid']"/>
            <xsl:text>). It is not a copy of the Wikipedia page.</xsl:text>
          </p>
          <header class="wiki-header">
            <h1><xsl:value-of select="$bibl/tei:title"/></h1>
            <p class="wiki-tagline">
              <xsl:text>Text of the English Wikipedia article, revision </xsl:text>
              <a href="{$bibl/tei:ref/@target}"><xsl:value-of select="$bibl/tei:idno[@type='wikipedia-oldid']"/></a>
              <xsl:text> (</xsl:text><xsl:value-of select="$bibl/tei:date"/>
              <xsl:text>), encoded in TEI. Names in the text link to their description in the TEI standOff layer.</xsl:text>
            </p>
          </header>
          <div class="wiki-layout">
            <nav class="wiki-toc" aria-label="Contents">
              <p class="wiki-toc__title">Contents</p>
              <ol>
                <li><a href="#lead">(Top)</a></li>
                <xsl:for-each select="tei:text/tei:body/tei:div[not(@type='lead')] | tei:text/tei:back/tei:div">
                  <li><a href="#{@xml:id}"><xsl:value-of select="tei:head"/></a></li>
                </xsl:for-each>
                <li><a href="#wiki-entities">Entities</a></li>
              </ol>
            </nav>
            <main class="wiki-article">
              <xsl:call-template name="infobox"/>
              <xsl:apply-templates select="tei:text/tei:body/tei:div"/>
              <xsl:apply-templates select="tei:text/tei:back"/>
              <details id="wiki-entities" class="wiki-entities">
                <summary>Entities annotated in this article, from the TEI standOff layer</summary>
                <xsl:call-template name="entity-group">
                  <xsl:with-param name="title">People</xsl:with-param>
                  <xsl:with-param name="nodes" select="tei:standOff/tei:listPerson/tei:person"/>
                  <xsl:with-param name="kind">person</xsl:with-param>
                </xsl:call-template>
                <xsl:call-template name="entity-group">
                  <xsl:with-param name="title">Places</xsl:with-param>
                  <xsl:with-param name="nodes" select="tei:standOff/tei:listPlace/tei:place"/>
                  <xsl:with-param name="kind">place</xsl:with-param>
                </xsl:call-template>
                <xsl:call-template name="entity-group">
                  <xsl:with-param name="title">Institutions</xsl:with-param>
                  <xsl:with-param name="nodes" select="tei:standOff/tei:listOrg/tei:org"/>
                  <xsl:with-param name="kind">organization</xsl:with-param>
                </xsl:call-template>
                <xsl:call-template name="entity-group">
                  <xsl:with-param name="title">Manuscripts</xsl:with-param>
                  <xsl:with-param name="nodes" select="tei:standOff/tei:listObject/tei:object | tei:standOff/tei:list[@xml:id='digital-objects']/tei:item"/>
                  <xsl:with-param name="kind">physical-object</xsl:with-param>
                </xsl:call-template>
                <xsl:call-template name="entity-group">
                  <xsl:with-param name="title">Events</xsl:with-param>
                  <xsl:with-param name="nodes" select="tei:standOff/tei:listEvent/tei:event"/>
                  <xsl:with-param name="kind">event</xsl:with-param>
                </xsl:call-template>
                <xsl:call-template name="entity-group">
                  <xsl:with-param name="title">Time-spans</xsl:with-param>
                  <xsl:with-param name="nodes" select="tei:standOff/tei:list[@xml:id='time-spans']/tei:item"/>
                  <xsl:with-param name="kind">time-span</xsl:with-param>
                </xsl:call-template>
              </details>
            </main>
          </div>
          <script>
            // Following a name opens the folded entity list so that its description is visible.
            document.querySelectorAll('#wiki-root a.tei-entity, #wiki-root a.wiki-entity-link').forEach(function (a) {
              a.addEventListener('click', function () {
                var d = document.getElementById('wiki-entities'); if (d) { d.open = true; }
              });
            });
          </script>
        </div>
      </body>
    </html>
  </xsl:template>

  <!-- Infobox: every value is read from the TEI standOff layer -->
  <xsl:template name="infobox">
    <xsl:variable name="so" select="tei:standOff"/>
    <xsl:variable name="corpus" select="key('by-id', 'dunhuang-manuscripts')"/>
    <xsl:variable name="rels" select="$so/tei:listRelation[@type='conceptual']/tei:relation"/>
    <xsl:variable name="fig" select="tei:text/tei:body//tei:figure[tei:graphic][contains(tei:figDesc, 'Cave 16')][1]"/>
    <aside class="wiki-infobox" aria-label="Summary">
      <p class="wiki-infobox__title"><xsl:value-of select="$corpus/tei:objectIdentifier/tei:objectName"/></p>
      <xsl:if test="$fig">
        <img src="{$base}{$fig/tei:graphic/@url}" alt="{$fig/tei:figDesc}"/>
        <p class="wiki-infobox__caption">Cave 16 and the doorway to the Library Cave, 1907</p>
      </xsl:if>
      <table>
        <tr><th>Discovered</th><td>
          <xsl:value-of select="key('by-id', substring-after($rels[@active='#discovery-event'][@name='crm:P4_has_time-span']/@passive, '#'))/tei:date"/>
          <xsl:text>, by </xsl:text>
          <xsl:call-template name="entity-link"><xsl:with-param name="ref" select="$rels[@active='#discovery-event'][@name='crm:P14_carried_out_by']/@passive"/></xsl:call-template>
        </td></tr>
        <tr><th>Found in</th><td>
          <xsl:call-template name="entity-link"><xsl:with-param name="ref" select="$rels[@active='#sealing-event'][@name='crm:P7_took_place_at']/@passive"/></xsl:call-template>
          <xsl:text>, </xsl:text>
          <xsl:call-template name="entity-link"><xsl:with-param name="ref" select="$rels[@active='#library-cave'][@name='crm:P89_falls_within']/@passive"/></xsl:call-template>
        </td></tr>
        <tr><th>Held by</th><td>
          <xsl:for-each select="$rels[@name='crm:P50_has_current_keeper']">
            <xsl:call-template name="entity-link"><xsl:with-param name="ref" select="@passive"/></xsl:call-template>
            <xsl:text> (</xsl:text>
            <xsl:call-template name="node-label"><xsl:with-param name="node" select="key('by-id', substring-after(current()/@active, '#'))"/></xsl:call-template>
            <xsl:text>)</xsl:text>
            <xsl:if test="position() != last()"><br/></xsl:if>
          </xsl:for-each>
        </td></tr>
        <tr><th>Digitized by</th><td>
          <xsl:call-template name="entity-link"><xsl:with-param name="ref" select="$rels[@active='#digitization-event'][@name='crm:P14_carried_out_by']/@passive"/></xsl:call-template>
        </td></tr>
        <tr><th>Authority records</th><td>
          <xsl:for-each select="$corpus/tei:objectIdentifier/tei:idno[@type='wikidata' or @type='viaf' or @type='lc' or @type='fast']">
            <a>
              <xsl:attribute name="href">
                <xsl:choose>
                  <xsl:when test="@type='wikidata'">https://www.wikidata.org/wiki/<xsl:value-of select="."/></xsl:when>
                  <xsl:when test="@type='viaf'">https://viaf.org/viaf/<xsl:value-of select="."/></xsl:when>
                  <xsl:when test="@type='lc'">https://id.loc.gov/authorities/names/<xsl:value-of select="."/>.html</xsl:when>
                  <xsl:otherwise>https://id.worldcat.org/fast/<xsl:value-of select="."/></xsl:otherwise>
                </xsl:choose>
              </xsl:attribute>
              <xsl:choose>
                <xsl:when test="@type='wikidata'">Wikidata</xsl:when>
                <xsl:when test="@type='viaf'">VIAF</xsl:when>
                <xsl:when test="@type='lc'">Library of Congress</xsl:when>
                <xsl:otherwise>FAST</xsl:otherwise>
              </xsl:choose>
            </a>
            <xsl:if test="position() != last()"><xsl:text>, </xsl:text></xsl:if>
          </xsl:for-each>
        </td></tr>
      </table>
      <p class="wiki-infobox__note">Values read from the TEI standOff layer.</p>
    </aside>
  </xsl:template>

  <xsl:template name="entity-link">
    <xsl:param name="ref"/>
    <a class="wiki-entity-link" href="#entity-{substring-after($ref, '#')}">
      <xsl:call-template name="node-label"><xsl:with-param name="node" select="key('by-id', substring-after($ref, '#'))"/></xsl:call-template>
    </a>
  </xsl:template>

  <xsl:template name="wiki-style">
    <style>
      #wiki-root { --w-text: #202122; --w-link: #3366CC; --w-rule: #A2A9B1; --w-box: #F8F9FA;
        background: #FFFFFF; color: var(--w-text); font-family: -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
        font-size: 16px; line-height: 1.6; padding: 0 0 24px; }
      #wiki-root a { color: var(--w-link); text-decoration: none; }
      #wiki-root a:hover { text-decoration: underline; }
      #wiki-root .wiki-banner { margin: 0; padding: 10px 16px; background: #EAF3FF; border-bottom: 1px solid #C8CCD1; font-size: 14px; color: var(--w-text); }
      #wiki-root .wiki-header { padding: 20px 24px 8px; border-bottom: 1px solid var(--w-rule); }
      #wiki-root h1 { font-family: 'Linux Libertine', Georgia, Times, serif; font-weight: 400; font-size: 32px; line-height: 1.3; margin: 0 0 4px; letter-spacing: 0; }
      #wiki-root .wiki-tagline { margin: 0 0 8px; font-size: 14px; color: #54595D; max-width: none; }
      #wiki-root .wiki-layout { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 28px; padding: 16px 24px 0; }
      #wiki-root .wiki-toc { position: sticky; top: 80px; align-self: start; font-size: 14px; max-height: calc(100vh - 100px); overflow: auto; }
      #wiki-root .wiki-toc__title { font-weight: 700; margin: 0 0 6px; border-bottom: 1px solid #C8CCD1; padding-bottom: 4px; }
      #wiki-root .wiki-toc ol { list-style: none; margin: 0; padding: 0; }
      #wiki-root .wiki-toc li { margin: 0 0 6px; line-height: 1.35; }
      #wiki-root h2 { font-family: 'Linux Libertine', Georgia, Times, serif; font-weight: 400; font-size: 24px; line-height: 1.3; margin: 24px 0 8px; padding-bottom: 2px; border-bottom: 1px solid var(--w-rule); letter-spacing: 0; }
      #wiki-root p { margin: 8px 0 12px; max-width: none; }
      #wiki-root .lead { font-family: inherit; font-size: inherit; font-style: normal; line-height: inherit; margin: 0; max-width: none; }
      #wiki-root ul { padding-left: 1.6em; }
      #wiki-root li { margin: 2px 0; }
      #wiki-root .wiki-infobox { float: right; clear: right; width: 300px; margin: 0 0 16px 20px; padding: 6px; background: var(--w-box); border: 1px solid var(--w-rule); font-size: 14px; line-height: 1.45; }
      #wiki-root .wiki-infobox__title { text-align: center; font-weight: 700; font-size: 17px; margin: 4px 0 8px; }
      #wiki-root .wiki-infobox img { display: block; width: 100%; height: auto; }
      #wiki-root .wiki-infobox__caption { text-align: center; font-size: 13px; margin: 4px 0 8px; }
      #wiki-root .wiki-infobox table { width: 100%; border-collapse: collapse; font-family: inherit; font-size: 14px; }
      #wiki-root .wiki-infobox th { text-align: left; vertical-align: top; padding: 4px 6px 4px 2px; font-weight: 700; color: var(--w-text); border: 0; font-variant-caps: normal; letter-spacing: 0; width: 38%; }
      #wiki-root .wiki-infobox td { padding: 4px 2px; border: 0; vertical-align: top; }
      #wiki-root .wiki-infobox__note { font-size: 12px; color: #54595D; text-align: center; margin: 6px 0 2px; }
      #wiki-root figure { margin: 8px 0 14px; padding: 4px; border: 1px solid #C8CCD1; background: var(--w-box); max-width: 320px; }
      #wiki-root figure.has-image { float: right; clear: right; margin-left: 20px; }
      #wiki-root figure img { display: block; width: 100%; height: auto; }
      #wiki-root figcaption { font-family: inherit; font-size: 13px; line-height: 1.4; color: var(--w-text); margin: 4px 2px 2px; max-width: none; }
      #wiki-root blockquote.tei-cit { margin: 12px 0 16px; padding: 4px 0 4px 18px; border-left: 3px solid #C8CCD1; }
      #wiki-root .tei-quote { display: block; }
      #wiki-root .tei-attribution { display: block; color: #54595D; margin-top: 4px; }
      #wiki-root .citation { font-size: 0.78em; vertical-align: super; line-height: 0; }
      #wiki-root .tei-entity { border-bottom: 1px dotted #72777D; }
      #wiki-root time { font-variant-numeric: normal; }
      #wiki-root .references { font-size: 14px; }
      #wiki-root cite.tei-title { font-style: italic; }
      #wiki-root .wiki-entities { clear: both; margin-top: 28px; border-top: 1px solid var(--w-rule); padding-top: 12px; max-width: none; }
      #wiki-root .wiki-entities summary { font-size: 16px; font-weight: 700; color: var(--w-text); cursor: pointer; font-family: inherit; }
      #wiki-root .entity-group h4 { font-size: 15px; margin: 16px 0 6px; }
      #wiki-root .entity-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }
      #wiki-root .entity-card { border: 1px solid #C8CCD1; background: var(--w-box); padding: 8px 10px; font-size: 13px; scroll-margin-top: 90px; }
      #wiki-root .entity-card:target { outline: 2px solid var(--w-link); }
      #wiki-root .entity-card h4 { margin: 0 0 4px; font-size: 14px; }
      #wiki-root .entity-card dl { margin: 0; }
      #wiki-root .entity-card dt { color: #54595D; font-size: 12px; }
      #wiki-root .entity-card dd { margin: 0 0 4px; overflow-wrap: anywhere; }
      @media (max-width: 860px) {
        #wiki-root .wiki-layout { grid-template-columns: 1fr; }
        #wiki-root .wiki-toc { position: static; max-height: none; border: 1px solid #C8CCD1; background: var(--w-box); padding: 8px 12px; }
        #wiki-root .wiki-infobox, #wiki-root figure.has-image { float: none; width: auto; max-width: 100%; margin: 0 0 16px; }
      }
    </style>
  </xsl:template>

  <xsl:template match="tei:body/tei:div">
    <section>
      <xsl:attribute name="id"><xsl:value-of select="@xml:id"/></xsl:attribute>
      <xsl:attribute name="class">
        <xsl:text>source-section</xsl:text>
        <xsl:if test="@type='lead'"> lead</xsl:if>
      </xsl:attribute>
      <xsl:if test="not(@type='lead')">
        <h2><xsl:value-of select="tei:head"/></h2>
      </xsl:if>
      <xsl:apply-templates select="node()[not(self::tei:head)]"/>
    </section>
  </xsl:template>

  <xsl:template match="tei:back">
    <xsl:apply-templates select="tei:div"/>
  </xsl:template>

  <xsl:template match="tei:back/tei:div">
    <section class="source-section back-matter">
      <xsl:attribute name="id"><xsl:value-of select="@xml:id"/></xsl:attribute>
      <h2><xsl:value-of select="tei:head"/></h2>
      <xsl:apply-templates select="node()[not(self::tei:head)]"/>
    </section>
  </xsl:template>

  <xsl:template match="tei:p">
    <xsl:choose>
      <xsl:when test="count(*) = 1 and tei:cit and normalize-space(text()) = ''">
        <xsl:apply-templates/>
      </xsl:when>
      <xsl:otherwise>
        <p><xsl:apply-templates/></p>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template match="tei:list">
    <ul><xsl:apply-templates/></ul>
  </xsl:template>

  <xsl:template match="tei:item">
    <li><xsl:apply-templates/></li>
  </xsl:template>

  <xsl:template match="tei:figure">
    <figure>
      <xsl:if test="tei:graphic">
        <xsl:attribute name="class">has-image</xsl:attribute>
        <img src="{$base}{tei:graphic/@url}" alt="{normalize-space(tei:figDesc)}"/>
      </xsl:if>
      <figcaption><xsl:apply-templates select="tei:figDesc/node()"/></figcaption>
    </figure>
  </xsl:template>

  <xsl:template match="tei:cit">
    <blockquote class="tei-cit">
      <xsl:apply-templates/>
    </blockquote>
  </xsl:template>

  <xsl:template match="tei:quote">
    <span class="tei-quote"><xsl:apply-templates/></span>
  </xsl:template>

  <xsl:template match="tei:bibl[@type='attribution']">
    <xsl:apply-templates/>
  </xsl:template>

  <xsl:template match="tei:seg[@type='attribution']">
    <span class="tei-attribution"><xsl:apply-templates/></span>
  </xsl:template>

  <xsl:template match="tei:listBibl">
    <xsl:choose>
      <xsl:when test="ancestor::tei:div[@xml:id='references']">
        <ol class="references">
          <xsl:apply-templates select="tei:bibl"/>
        </ol>
      </xsl:when>
      <xsl:otherwise>
        <ul class="bibliography">
          <xsl:apply-templates select="tei:bibl"/>
        </ul>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template match="tei:bibl">
    <li>
      <xsl:if test="@xml:id">
        <xsl:attribute name="id"><xsl:value-of select="@xml:id"/></xsl:attribute>
      </xsl:if>
      <xsl:apply-templates/>
    </li>
  </xsl:template>

  <xsl:template match="tei:back//tei:bibl//tei:title">
    <cite class="tei-title"><xsl:apply-templates/></cite>
  </xsl:template>

  <xsl:template match="tei:ref[starts-with(@target, '#bibl-')]">
    <a>
      <xsl:attribute name="href"><xsl:value-of select="@target"/></xsl:attribute>
      <xsl:attribute name="class">citation</xsl:attribute>
      <xsl:apply-templates/>
    </a>
  </xsl:template>

  <xsl:template match="tei:ref[starts-with(@target, 'http://') or starts-with(@target, 'https://')]">
    <a>
      <xsl:attribute name="href"><xsl:value-of select="@target"/></xsl:attribute>
      <xsl:attribute name="target">_blank</xsl:attribute>
      <xsl:attribute name="rel">noopener noreferrer</xsl:attribute>
      <xsl:apply-templates/>
    </a>
  </xsl:template>

  <xsl:template match="tei:ref">
    <a>
      <xsl:attribute name="href"><xsl:value-of select="@target"/></xsl:attribute>
      <xsl:apply-templates/>
    </a>
  </xsl:template>

  <xsl:template match="tei:persName[@ref]">
    <a class="tei-entity tei-person">
      <xsl:attribute name="href">#entity-<xsl:value-of select="substring-after(@ref, '#')"/></xsl:attribute>
      <xsl:attribute name="data-ref"><xsl:value-of select="@ref"/></xsl:attribute>
      <xsl:apply-templates/>
    </a>
  </xsl:template>

  <xsl:template match="tei:placeName[@ref]">
    <a class="tei-entity tei-place">
      <xsl:attribute name="href">#entity-<xsl:value-of select="substring-after(@ref, '#')"/></xsl:attribute>
      <xsl:attribute name="data-ref"><xsl:value-of select="@ref"/></xsl:attribute>
      <xsl:apply-templates/>
    </a>
  </xsl:template>

  <xsl:template match="tei:orgName[@ref]">
    <a class="tei-entity tei-org">
      <xsl:attribute name="href">#entity-<xsl:value-of select="substring-after(@ref, '#')"/></xsl:attribute>
      <xsl:attribute name="data-ref"><xsl:value-of select="@ref"/></xsl:attribute>
      <xsl:apply-templates/>
    </a>
  </xsl:template>

  <xsl:template match="tei:objectName[@ref]">
    <a class="tei-entity tei-object">
      <xsl:attribute name="href">#entity-<xsl:value-of select="substring-after(@ref, '#')"/></xsl:attribute>
      <xsl:attribute name="data-ref"><xsl:value-of select="@ref"/></xsl:attribute>
      <xsl:apply-templates/>
    </a>
  </xsl:template>

  <xsl:template match="tei:term[@ana]">
    <span class="tei-entity tei-concept">
      <xsl:attribute name="data-ana"><xsl:value-of select="@ana"/></xsl:attribute>
      <xsl:apply-templates/>
    </span>
  </xsl:template>

  <xsl:template match="tei:date[@when]">
    <time>
      <xsl:attribute name="datetime"><xsl:value-of select="@when"/></xsl:attribute>
      <xsl:apply-templates/>
    </time>
  </xsl:template>

  <xsl:template match="tei:foreign[@xml:lang]">
    <span>
      <xsl:attribute name="lang"><xsl:value-of select="@xml:lang"/></xsl:attribute>
      <xsl:apply-templates/>
    </span>
  </xsl:template>

  <xsl:template name="entity-group">
    <xsl:param name="title"/>
    <xsl:param name="nodes"/>
    <xsl:param name="kind"/>
    <section class="entity-group">
      <xsl:attribute name="data-entity-kind"><xsl:value-of select="$kind"/></xsl:attribute>
      <h4><xsl:value-of select="$title"/></h4>
      <div class="entity-grid">
        <xsl:for-each select="$nodes">
          <xsl:call-template name="entity-card">
            <xsl:with-param name="kind" select="$kind"/>
          </xsl:call-template>
        </xsl:for-each>
      </div>
    </section>
  </xsl:template>

  <xsl:template name="entity-card">
    <xsl:param name="kind"/>
    <article class="entity-card">
      <xsl:attribute name="id">entity-<xsl:value-of select="@xml:id"/></xsl:attribute>
      <xsl:attribute name="data-tei-id"><xsl:value-of select="@xml:id"/></xsl:attribute>
      <xsl:attribute name="data-entity-kind"><xsl:value-of select="$kind"/></xsl:attribute>
      <h4>
        <xsl:call-template name="node-label">
          <xsl:with-param name="node" select="."/>
        </xsl:call-template>
      </h4>
      <dl>
        <dt>xml:id</dt>
        <dd><xsl:value-of select="@xml:id"/></dd>
        <dt>Conceptual class</dt>
        <dd><xsl:value-of select="tei:note[@type='conceptualClass']"/></dd>
        <xsl:if test="tei:idno | tei:objectIdentifier/tei:idno">
          <dt>Authority identifiers</dt>
          <dd>
            <xsl:for-each select="tei:idno | tei:objectIdentifier/tei:idno">
              <span class="authority-id">
                <xsl:value-of select="@type"/>
                <xsl:text>: </xsl:text>
                <xsl:value-of select="."/>
              </span>
              <xsl:if test="position() != last()"><br/></xsl:if>
            </xsl:for-each>
          </dd>
        </xsl:if>
      </dl>
    </article>
  </xsl:template>

  <xsl:template name="node-label">
    <xsl:param name="node"/>
    <xsl:choose>
      <xsl:when test="$node/tei:persName[1]"><xsl:value-of select="$node/tei:persName[1]"/></xsl:when>
      <xsl:when test="$node/tei:placeName[1]"><xsl:value-of select="$node/tei:placeName[1]"/></xsl:when>
      <xsl:when test="$node/tei:orgName[1]"><xsl:value-of select="$node/tei:orgName[1]"/></xsl:when>
      <xsl:when test="$node/tei:objectIdentifier/tei:objectName[1]"><xsl:value-of select="$node/tei:objectIdentifier/tei:objectName[1]"/></xsl:when>
      <xsl:when test="$node/tei:name[1]"><xsl:value-of select="$node/tei:name[1]"/></xsl:when>
      <xsl:when test="$node/tei:label[1]"><xsl:value-of select="$node/tei:label[1]"/></xsl:when>
      <xsl:when test="$node/tei:date[1]"><xsl:value-of select="$node/tei:date[1]"/></xsl:when>
      <xsl:otherwise><xsl:value-of select="$node/@xml:id"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

</xsl:stylesheet>
