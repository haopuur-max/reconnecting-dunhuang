# Reconnecting Dunhuang - project-specific properties (dm:)
# Version 2.1 (2026-10-13: versions of the reused models stated; properties unchanged since 2.0)
#
# Only three properties are defined here. Each exists because no property in
# CIDOC CRM 7.1.3, CRMsci 3.2 or CRMdig 5.0 expresses the meaning stated in the source;
# the existing properties that were considered, and why they were rejected,
# are recorded in skos:editorialNote.

@prefix dm:      <https://haopuur-max.github.io/reconnecting-dunhuang/ontology/> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://haopuur-max.github.io/reconnecting-dunhuang/ontology/> a owl:Ontology ;
    rdfs:label "Reconnecting Dunhuang project properties"@en ;
    dcterms:description "Three project-specific object properties used together with CIDOC CRM 7.1.3, CRMsci 3.2 and CRMdig 5.0 in the Reconnecting Dunhuang dataset."@en ;
    rdfs:seeAlso <http://www.cidoc-crm.org/cidoc-crm/7.1.3/> ,
        <http://www.cidoc-crm.org/extensions/crmsci/3.2/> ,
        <https://cidoc-crm.org/crmdig/ModelVersion/crmdig-v5.0> ;
    owl:versionInfo "2.1" ;
    dcterms:modified "2026-10-13" .

dm:partOfNetwork a owl:ObjectProperty ;
    rdfs:label "part of network"@en ;
    skos:definition "Relates a place to a larger historical network of routes of which it was a node."@en ;
    rdfs:domain crm:E53_Place ;
    rdfs:range crm:E53_Place ;
    skos:scopeNote "Source basis: Sachu (modern-day Dunhuang) 'formed part of the Silk Road network' (R1)."@en ;
    skos:editorialNote "Considered crm:P89_falls_within (spatial containment: Dunhuang is not contained in a route network) and crm:P121_overlaps_with (spatially true but loses the meaning of network membership). No subproperty axiom is asserted in this version."@en ;
    rdfs:isDefinedBy <https://haopuur-max.github.io/reconnecting-dunhuang/ontology/> .

dm:locatedNear a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "located near"@en ;
    skos:definition "Relates two places that are close to each other without sharing a boundary or one containing the other."@en ;
    rdfs:domain crm:E53_Place ;
    rdfs:range crm:E53_Place ;
    skos:scopeNote "Source basis: 'the Mogao Caves near Sachu in Dunhuang' (R2). Encoded in TEI with @mutual."@en ;
    skos:editorialNote "Considered crm:P122_borders_with (requires a shared boundary) and crm:P89_falls_within (the source does not state containment). CIDOC CRM has no property for proximity."@en ;
    rdfs:isDefinedBy <https://haopuur-max.github.io/reconnecting-dunhuang/ontology/> .

dm:virtuallyBringsTogether a owl:ObjectProperty ;
    rdfs:label "virtually brings together"@en ;
    skos:definition "Relates an actor to a dispersed physical corpus whose parts it reunites in a shared digital environment."@en ;
    rdfs:domain crm:E39_Actor ;
    rdfs:range crm:E18_Physical_Thing ;
    skos:scopeNote "Project interpretation (R16, Enriched evidence), supported by the International Dunhuang Programme's institutional description (https://idp.bl.uk/about/), not by the Wikipedia revision alone."@en ;
    skos:editorialNote "No CIDOC CRM, CRMsci or CRMdig property expresses virtual reunification of a dispersed physical corpus. The digital surrogate itself is linked through crmdig:L11_had_output and dcterms:publisher."@en ;
    rdfs:isDefinedBy <https://haopuur-max.github.io/reconnecting-dunhuang/ontology/> .

# Retired in v2.0: dm:providesDigitalAccessTo
# Replaced by dcterms:publisher (digital surrogate -> International Dunhuang Project),
# because dcterms:publisher already means "an entity responsible for making the
# resource available". It is intentionally no longer declared.
