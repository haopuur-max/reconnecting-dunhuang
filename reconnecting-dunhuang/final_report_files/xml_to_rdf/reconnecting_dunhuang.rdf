  <rdf:Description rdf:about="https://haopuur-max.github.io/reconnecting-dunhuang/resource/evidence/enriched">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>Enriched evidence (additional authoritative source)</rdfs:label>
    <skos:inScheme rdf:resource="https://haopuur-max.github.io/reconnecting-dunhuang/resource/concept-scheme/evidence-types"/>
    <skos:definition xml:lang="en">Enriched relation supported by an additional authoritative source rather than by the frozen Wikipedia revision. In this project: R16 is the project's interpretation of the International Dunhuang Project's (now International Dunhuang Programme) institutional description; R17-R19 add one documented item, the printed Diamond Sutra of 868 (British Library, Or.8210/P.2), from the IDP catalogue and research articles. Each Enriched relation points to its own sources (relation/@source, listBibl enrichment-sources) and is kept distinct from Direct evidence drawn from the frozen Wikipedia revision.</skos:definition>
  </rdf:Description>
